# Copy to .env (git-ignored) and fill in. Loaded by spring-dotenv.

# Required: BASE64-encoded secret (>= 32 bytes) for signing JWTs.
# Generate your own with:  openssl rand -base64 48
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48

# The assigned website: Macedonian Wikisource (defaults shown).
SOURCE_NAME=Vikizvor (mk.wikisource.org)
SOURCE_BASE_URL=https://mk.wikisource.org
# Wikimedia asks for a User-Agent with contact info: https://meta.wikimedia.org/wiki/User-Agent_policy
SOURCE_USER_AGENT=VezilkaMcpTool/1.0 (FINKI EMC 2026; your.name@students.finki.ukim.mk)
SOURCE_REQUEST_DELAY_MS=200

# doniraj.vezilka.ai integration.
#   export = write ready-to-upload .docx files + manifest.jsonl to VEZILKA_OUTBOX_DIR (default)
#   upload = upload each donation automatically (as .docx, anonymously) to the endpoint the
#            site's own donation form uses; you donate under Vezilka's terms of use
#   http   = POST to VEZILKA_BASE_URL + VEZILKA_SUBMIT_PATH with the API key (if Vezilka ever publishes an API)
VEZILKA_MODE=export
VEZILKA_OUTBOX_DIR=vezilka-outbox
VEZILKA_UPLOAD_PATH=/api/donations/raw-text/
VEZILKA_BASE_URL=https://doniraj.vezilka.ai
VEZILKA_API_KEY=
VEZILKA_SUBMIT_PATH=/api/donations/text
VEZILKA_STATUS_PATH=/api/donations/{reference}
